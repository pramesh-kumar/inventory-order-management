# Database configurations (PostgreSQL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_password
POSTGRES_DB=inventory_db
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Backend Connection URL (for local backend connecting to DB)
# For local docker-compose, this should be: postgresql://postgres:postgres_password@db:5432/inventory_db
# For local development running backend directly: postgresql://postgres:postgres_password@localhost:5432/inventory_db
DATABASE_URL=postgresql://postgres:postgres_password@db:5432/inventory_db

# Frontend Configurations
# VITE_API_URL should point to the backend URL.
# Local compose: http://localhost:8000
# Production: http://<your-render-backend-url>
VITE_API_URL=http://localhost:8000
